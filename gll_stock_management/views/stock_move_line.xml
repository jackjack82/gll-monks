<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gll_view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">gll.stock.move.line.operations.list</field>
        <field name="model">stock.move.line</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='result_package_id'][2]" position="after">
                <field name="package_type_id"/>
            </xpath>
        </field>
    </record>


</odoo>
