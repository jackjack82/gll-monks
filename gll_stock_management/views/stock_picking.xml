<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gll_stock_picking_form_view" model="ir.ui.view">
        <field name="name">gll.stock.picking.form.view</field>
        <field name="model">stock.picking</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_see_packages']" position="after">
                <button name="action_view_delivery_receipts_orders" type="object"
                        class="oe_stat_button" icon="fa-wrench" string="Orders"
                        invisible="gll_so_count == 0">
                        <field name="gll_so_count" string="Sale Orders" widget="statinfo"/>
                </button>
            </xpath>
            <field name="partner_id" position="after">
                <field name="delivery_partner_id"/>
                <field name="trip_id"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </field>
            <!-- Add partner address fields after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <div class="o_address_format">
                    <field name="partner_street" placeholder="Street..." class="o_address_street"/>
                    <field name="partner_zip" placeholder="ZIP" class="o_address_zip"/>
                    <field name="partner_city" placeholder="City" class="o_address_city"/>
                    <field name="partner_country_id" placeholder="Country" class="o_address_country"/>
                </div>
            </xpath>
            <field name="origin" position="after">
                <field name="shipping_weight"/>
                <field name="items_count"/>
                <field name="packages_count"/>
                <field name="items_volume"/>
                <!-- Add fixed_total for outgoing pickings -->
                <field name="fixed_total" invisible="picking_type_code != 'outgoing'"/>
            </field>

            <xpath expr="//sheet/group" position="after">
                <group string="Totals Value of Services" readonly="1" col="12">
                    <group colspan="3">
                        <field name="variable_total" readonly="1"/>
                        <field name="fixed_total" readonly="1"/>
                    </group>
                    <group colspan="3">
                        <field name="additional_total" readonly="1"/>
                        <field name="accessories_total" readonly="1"/>
                    </group>
                    <group colspan="3">
                        <field name="transport_total" readonly="1"/>
                        <field name="warehouse_total" readonly="1"/>

                    </group>
                </group>
            </xpath>
            <!-- Add service tabs for incoming pickings -->
            <xpath expr="//notebook" position="inside">

                <page string="Fixed S." invisible="picking_type_code == 'internal'">
                    <field name="fixed_service_ids" context="{'default_pick_service_type': 'fixed', 'default_picking_id': id}">
                        <list editable="bottom">
                            <field name="product_id" domain="[('pick_service_type', '=', 'fixed')]"/>
                            <field name="quantity"/>
                            <field name="pick_service_type" column_invisible="1"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                            <button name="add_line_to_sale_order"
                                    type="object" title="Add to Order"
                                    icon="fa-list-ul" invisible="so_amount"
                                    help="Click here if you want to add this line to the current Sale Order"/>
                        </list>
                    </field>
                </page>
                <page string="Variable S." invisible="picking_type_code == 'internal'">
                    <field name="variable_service_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('pick_service_type', '=', 'variable')]"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                        </list>
                    </field>
                </page>
                <page string="Warehouse S."  invisible="picking_type_code == 'internal'">
                    <field name="warehouse_service_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('pick_service_type', '=', 'warehouse')]"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                        </list>
                    </field>
                </page>
                <page string="Transport S."  invisible="picking_type_code == 'internal'">
                    <field name="transport_service_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('pick_service_type', '=', 'transport')]"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                        </list>
                    </field>
                </page>
                <page string="Accessories S."  invisible="picking_type_code == 'internal'">
                    <field name="accessories_service_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('pick_service_type', '=', 'accessories')]"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                        </list>
                    </field>
                </page>
                <page string="Additional S."  invisible="picking_type_code == 'internal'">
                    <field name="additional_service_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('pick_service_type', '=', 'additional')]"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                        </list>
                    </field>
                </page>

            </xpath>
        </field>
    </record>

    <record id="gll_view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">gll.delivery.stock.picking_withcarrier.form.view</field>
        <field name="model">stock.picking</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='shipping_weight']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='shipping_weight']/parent::div" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="gll_view_pcking_search" model="ir.ui.view">
        <field name="name">gll.stock.picking.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="delivery_partner_id"/>
            </field>
        </field>
    </record>

    <record id="gll_stock_picking_list" model="ir.ui.view">
        <field name="name">gll.stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="delivery_partner_id"/>
            </field>
        </field>
    </record>

</odoo>
