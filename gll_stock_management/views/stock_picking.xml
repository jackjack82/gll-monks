<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gll_stock_picking_form_view" model="ir.ui.view">
        <field name="name">gll.stock.picking.form.view</field>
        <field name="model">stock.picking</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_td_label')]" position="replace">
            <div class="o_td_label">
                <label for="partner_id" string="Receiver" style="font-weight:bold;" invisible="picking_type_code != 'outgoing'"/>
                <label for="partner_id" string="Receive From" style="font-weight:bold;" invisible="picking_type_code != 'incoming'"/>
                <label for="partner_id" string="Contact" style="font-weight:bold;" invisible="picking_type_code in ['incoming', 'outgoing']"/>
            </div>
            </xpath>

            <xpath expr="//button[@name='action_see_packages']" position="after">
                <button name="action_view_delivery_receipts_orders" type="object"
                        class="oe_stat_button" icon="fa-wrench" string="Orders"
                        invisible="gll_so_count == 0">
                        <field name="gll_so_count" string="Sale Orders" widget="statinfo"/>
                </button>
            </xpath>
            <field name="partner_id" position="replace">
                <!-- Add partner address fields after partner_id -->
                <div style="border: 1pt solid grey; border-radius: 10px; padding:2;">
                    <field name="partner_id"/>
                <field name="partner_street" placeholder="Street..." class="o_address_street"/>
                <div class="o_row">
                    <field name="partner_zip" placeholder="ZIP" class="oe_inline"/>
                    <field name="partner_city" placeholder="City" class="oe_inline"/>
                    <field name="partner_state_id" placeholder="State" class="oe_inline"/>
                </div>
                <field name="carrier_city"/>
                </div>
                <!-- Warning for inconvenient destination -->
                <div invisible="not is_inconvenient_destination"
                     style="background-color: #daedf7; color: #31708f; padding: 10px; margin-top: 10px; margin-bottom: 10px; border-radius: 4px;">
                    <strong>Warning:</strong> This destination is marked as an inconvenient place for the selected carrier.
                </div>
                <field name="is_inconvenient_destination" invisible="1"/>
                <field name="delivery_partner_id"/>
            </field>
            <!-- Move the notes to a smaller field below the locations-->
            <page name="note" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>
            <xpath expr="//field[@name='picking_type_id']/parent::group" position="inside">
                <field name="note"/>
            </xpath>
            <page name="operations" position="attributes">
                <attribute name="string">Products details</attribute>
            </page>
            <field name="origin" position="after">
                <field name="shipping_weight"/>
                <field name="items_count"/>
                <field name="packages_count"/>
                <field name="items_volume"/>
                <field name="transport_tariff"/>
            </field>

            <xpath expr="//sheet/group" position="after">
                <group string="Totals Value of Services" readonly="1" col="12">
                    <group colspan="3">
                        <field name="variable_total" readonly="1"/>
                        <field name="fixed_total" readonly="1"/>
                    </group>
                    <group colspan="3">
                        <field name="additional_total" readonly="1"/>
                        <field name="accessories_total" readonly="1"/>
                    </group>
                    <group colspan="3">
                        <field name="transport_total" readonly="1"/>
                        <field name="warehouse_total" readonly="1"/>

                    </group>
                </group>
            </xpath>
            <!-- Add service tabs for incoming pickings -->
            <xpath expr="//notebook" position="inside">
                <page string="Servizi" invisible="picking_type_code == 'internal'">
                    <field name="all_service_ids"
                           context="{'default_picking_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" domain="[('pick_service_type', '=', 'variable')]"/>
                            <field name="pick_service_type"/>
                            <button name="decrement_quantity" type="object" icon="fa-minus" title="Decrease quantity" class="oe_link"/>
                            <button name="increment_quantity" type="object" icon="fa-plus" title="Increase quantity" class="oe_link"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="total" sum="Total"/>
                            <field name="so_amount" sum="Ordered"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="gll_view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">gll.delivery.stock.picking_withcarrier.form.view</field>
        <field name="model">stock.picking</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='shipping_weight']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='shipping_weight']/parent::div" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>


    <record id="gll_view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">gll.stock.picking.withcarrier.form.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <field name="carrier_id" position="before">
                <field name="trip_ids" readonly="1" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="gll_view_pcking_search" model="ir.ui.view">
        <field name="name">gll.stock.picking.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="delivery_partner_id"/>
            </field>
        </field>
    </record>

    <record id="gll_stock_picking_list" model="ir.ui.view">
        <field name="name">gll.stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="delivery_partner_id"/>
            </field>
        </field>
    </record>

</odoo>
