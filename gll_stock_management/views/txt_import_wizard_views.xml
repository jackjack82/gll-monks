<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_txt_import_wizard_form" model="ir.ui.view">
        <field name="name">gll.txt.import.wizard.form</field>
        <field name="model">gll.txt.import.wizard</field>
        <field name="arch" type="xml">
            <form string="TXT Import Wizard">
                <header>
                    <button name="action_import" string="Import" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="filename" readonly="1" attrs="{'invisible': [('filename', '=', False)]}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="file" filename="filename" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook attrs="{'invisible': [('state', '=', 'draft')]}">
                        <page string="Results" attrs="{'invisible': [('state', '!=', 'done')]}">
                            <field name="results" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_txt_import_wizard_tree" model="ir.ui.view">
        <field name="name">gll.txt.import.wizard.tree</field>
        <field name="model">gll.txt.import.wizard</field>
        <field name="arch" type="xml">
            <tree string="TXT Imports" decoration-success="state == 'done'" decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="filename"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_txt_import_wizard_search" model="ir.ui.view">
        <field name="name">gll.txt.import.wizard.search</field>
        <field name="model">gll.txt.import.wizard</field>
        <field name="arch" type="xml">
            <search string="TXT Imports">
                <field name="filename"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Import Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_txt_import_wizard" model="ir.actions.act_window">
        <field name="name">TXT Import</field>
        <field name="res_model">gll.txt.import.wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new TXT import
            </p>
            <p>
                Import stock pickings from TXT files.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_txt_import_wizard"
              name="TXT Imports"
              parent="stock.menu_stock_root"
              action="action_txt_import_wizard"
              sequence="100"/>
</odoo>