<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Product Template Form View -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.gll</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add colli_per_strato and strati_per_pallet fields in the inventory tab -->
            <xpath expr="//page[@name='inventory']//group[@name='inventory']" position="inside">
                <group name="packaging_info" string="Packaging Information">
                    <field name="package_type"/>
                    <field name="colli_per_strato"/>
                    <field name="strati_per_pallet"/>
                </group>
                <group name="service_info" string="Service Information">
                    <field name="service_type"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
