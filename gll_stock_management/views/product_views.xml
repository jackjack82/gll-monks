<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Product Template Form View -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.gll</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add colli_per_strato and strati_per_pallet fields in the inventory tab -->
            <xpath expr="//page[@name='inventory']//group[@name='inventory']" position="inside">
                <group name="packaging_info" string="Packaging Information">
                    <field name="package_type"/>
                    <field name="colli_per_strato"/>
                    <field name="strati_per_pallet"/>
                </group>
            </xpath>
            <field name="categ_id" position="before">
                <field name="pick_service_type"/>
                <field name="warehouse_type" invisible="pick_service_type != 'warehouse'" required="pick_service_type == 'warehouse'"/>
                <field name="default_service" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="gll_product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.product.list.gll</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
           <field name="default_code" position="after">
               <field name="pick_service_type"/>
               <field name="warehouse_type"/>
                <field name="default_service" widget="boolean_toggle"/>
           </field>
        </field>
    </record>
</odoo>
