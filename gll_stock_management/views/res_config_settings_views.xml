<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.gll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='production_lot_info']" position="after">
                <h2>Servizi per Pacchetti</h2>
                <div class="row mt16 o_settings_container" id="package_services">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Servizi per Pacchetti</span>
                            <div class="text-muted">
                                Configura i servizi per i diversi tipi di pacchetto
                            </div>
                            <div class="content-group">
                                <div class="mt16 row">
                                    <label for="service_for_box_id" string="Servizio per scatola" class="col-lg-3 o_light_label"/>
                                    <field name="service_for_box_id" class="oe_inline"/>
                                </div>
                                <div class="mt16 row">
                                    <label for="service_for_single_id" string="Servizio per prodotto singolo" class="col-lg-3 o_light_label"/>
                                    <field name="service_for_single_id" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>