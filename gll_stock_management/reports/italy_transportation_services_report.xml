<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- QWeb template for the transportation services invoicing report -->
    <template id="italy_transportation_services_full_report">
        <t t-call="web.external_layout">
            <div class="page">
                <!-- ################ -->
                <!--    FIRST PAGE    -->
                <!-- ################ -->

                <!-- Customer information -->
                <div class="row">
                    <div class="col-12 text-start fw-bold">
                        <t t-esc="move.partner_id.display_name"/> — <t t-if="move.partner_id.street">
                        <t t-esc="move.partner_id.street"/>, </t><t t-if="move.partner_id.zip"><t t-esc="move.partner_id.zip"/>
                        </t><t t-if="move.partner_id.city"><t t-esc="move.partner_id.city"/> </t><t t-if="move.partner_id.state_id">
                        (<t t-esc="move.partner_id.state_id.code"/>), </t><t t-if="move.partner_id.country_id"><t t-esc="move.partner_id.country_id.name"/></t>
                    </div>
                </div>

                <!-- Title -->
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <h2>Fatturazione Servizi Trasporto Italia</h2>
                    </div>
                </div>
                <br/>
                <br/>

                <!-- Subtitle with period -->
                <div class="row">
                    <div class="col-12 text-center">
                        <h5>PERIODO DAL: <span t-field="move.period_from" t-options="{'widget': 'date'}"/> AL: <span t-field="move.period_to" t-options="{'widget': 'date'}"/></h5>
                    </div>
                </div>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
                <!-- Amounts block -->
                <div class="row mt-5">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr>
                                <td class="text-start">Tariffa trasporto</td>
                                <td class="text-end">
                                    <span t-field="move.transport_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-start">Spese Accessorie</td>
                                <td class="text-end">
                                    <span t-field="move.accessories_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-start">Servizi aggiuntivi e tariffazioni particolari</td>
                                <td class="text-end">
                                    <t t-set="additional_fixed_total" t-value="(move.additional_total or 0.0) + (move.fixed_total or 0.0)"/>
                                    <span t-esc="additional_fixed_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold">Imponibile</td>
                                <td class="text-end fw-bold">
                                    <span t-field="move.total_transport" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <!-- ################ -->
            <!-- RECEIPTS DETAILS -->
            <!-- ################ -->
            <p style="page-break-after:always;"></p>
            <!-- Content: For each picking found, display a table -->
            <t t-set="pickings_data" t-value="move.get_italy_transportation_report_data()"/>
            <t t-set="pickings" t-value="pickings_data['outgoing_data']"/>
            <t t-if="pickings">
                    <t t-foreach="pickings" t-as="picking">
                        <div class="mt-4 mb-2">
                            <table name="pick_delivery_resume" class="table table-sm table-bordered" style="font-size: 8pt; border: 1px solid #000; border-collapse: collapse;">

                                <!-- Row 1: Picking metadata -->
                                <tr>
                                    <td class="text-start" style="width: 8.33%">
                                        <strong><t t-esc="picking.name"/></strong>
                                    </td>
                                    <td class="text-start" style="width: 8.33%">
                                        <t t-esc="picking.scheduled_date" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td class="text-start" style="width: 16.67%" colspan="2">
                                        <t t-esc="picking.partner_id.display_name"/>
                                    </td>
                                    <td class="text-start" style="width: 8.33%">
                                        <span>Peso-Volume Tassabile: <t t-esc="picking.items_volume"/></span>
                                    </td>
                                    <td class="text-start" style="width: 58.33%" colspan="7">
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" disabled="disabled"/>
                                            <label class="form-check-label">Annullamento</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" disabled="disabled"/>
                                            <label class="form-check-label">Fermo deposito</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" disabled="disabled"/>
                                            <label class="form-check-label">Isole minori</label>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 3: Service values -->
                                <tr>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.warehouse_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.transport_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.accessories_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.additional_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.fixed_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.variable_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="alert alert-info mt-4">
                        <p>No incoming transfers found for this invoice.</p>
                    </div>
                </t>

        </t>
    </template>

    <!-- Report action template -->
    <template id="italy_transportation_services_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="move">
                <t t-call="gll_stock_management.italy_transportation_services_full_report"/>
            </t>
        </t>
    </template>

    <!-- Register the report in the system -->
    <record id="italy_transportation_services_report_action" model="ir.actions.report">
        <field name="name">Fatturazione Servizi Trasporto Italia</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gll_stock_management.italy_transportation_services_report</field>
        <field name="report_file">gll_stock_management.italy_transportation_services_report</field>
        <field name="print_report_name">"Fatturazione_Servizi_Trasporto_Italia_%(name)s"</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
