<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- QWeb template for the SERVIZI LOGISTICI invoicing report -->
    <template id="report_logistics_services_invoicing">
        <t t-call="web.external_layout">
            <div class="page">

                <!--######################-->
                <!--       FIRST PAGE     -->
                <!--######################-->

                <!-- Customer information -->
                <div class="row">
                    <div class="col-12 text-start fw-bold">
                        <t t-esc="move.partner_id.display_name"/> — <t t-if="move.partner_id.street">
                        <t t-esc="move.partner_id.street"/>, </t><t t-if="move.partner_id.zip"><t t-esc="move.partner_id.zip"/>
                        </t><t t-if="move.partner_id.city"><t t-esc="move.partner_id.city"/> </t><t t-if="move.partner_id.state_id">
                        (<t t-esc="move.partner_id.state_id.code"/>), </t><t t-if="move.partner_id.country_id"><t t-esc="move.partner_id.country_id.name"/></t>
                    </div>
                </div>

                <!-- Title -->
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <h2>Fatturazione Servizi Logistici</h2>
                    </div>
                </div>
                <br/>
                <br/>

                <!-- Subtitle with period -->
                <div class="row">
                    <div class="col-12 text-center">
                        <h5>PERIODO DAL: <span t-field="move.period_from" t-options="{'widget': 'date'}"/> AL: <span t-field="move.period_to" t-options="{'widget': 'date'}"/></h5>
                    </div>
                </div>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
                <!-- Amounts block -->
                <div class="row mt-5">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <table name="initial_totals" class="table table-sm">
                            <tr>
                                <td class="text-start">Servizi logistici</td>
                                <td class="text-end">
                                    <span t-field="move.logistics_services" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-start">Diritto Fisso</td>
                                <td class="text-end">
                                    <span t-field="move.fixed_fee" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-start">Preparazione</td>
                                <td class="text-end">
                                    <span t-field="move.preparation" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold">Imponibile</td>
                                <td class="text-end fw-bold">
                                    <span t-field="move.logistics_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}">31.05</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            <p style="page-break-after:always;"></p>
            NEW PAGE
                <!--######################-->
                <!--    ALL PICKINGS      -->
                <!--######################-->
                <div class="row mt-5">
                <!-- Pickings table -->
                    <table name="picking_details" class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th class="text-center">Spedizione</th>
                                <th class="text-center">Data</th>
                                <th class="text-center">Destinatario</th>
                                <th class="text-center">C.t.</th>
                                <th class="text-center">Kg</th>
                                <th class="text-center">Preparazione</th>
                                <th class="text-center">Diritto Fisso</th>
                                <th class="text-center">Servizi logistici</th>
                                <th class="text-center">Totale</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="pickings_data" t-value="move.get_logistic_services_report_data()"/>
                            <t t-foreach="pickings_data['data']" t-as="pick">
                                <tr>
                                    <td class="text-center"><span t-esc="pick['name']"/></td>
                                    <td class="text-center"><span t-esc="pick['date_done']" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-center"><span t-esc="pick['partner_id'].display_name"/></td>
                                    <td class="text-center"><span t-esc="pick['packages_count']"/></td>
                                    <td class="text-center"><span t-esc="pick['weight']"/></td>
                                    <td class="text-center"><span t-esc="pick['preparation_amount']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/></td>
                                    <td class="text-center"><span t-esc="pick['fixed_amount']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/></td>
                                    <td class="text-center"><span t-esc="pick['logistics_amount']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/></td>
                                    <td class="text-center"><span t-esc="pick['logistics_amount']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/></td>
                                </tr>
                                    <!--############################-->
                                    <!--    ADDTIONAL SERVICES      -->
                                <t t-set="additional_services" t-value="pick['additional_services']"/>
                                <tr t-if="additional_services">
                                    <td colspan="1"/>
                                    <td colspan="8">
                                        <table name="picking_additional_services" class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th class="text-center">Listino Competenze</th>
                                                    <th class="text-center">Service Description</th>
                                                    <th class="text-center">Quantity</th>
                                                    <th class="text-center">Price</th>
                                                    <th class="text-center">Total</th>
                                                    <th class="text-center">Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="additional_services" t-as="add_service">
                                                    <tr>
                                                        <td class="text-center"><span/>T</td>
                                                        <td class="text-center"><span t-esc="add_service.product_id.name"/></td>
                                                        <td class="text-center"><span t-esc="add_service.quantity"/></td>
                                                        <td class="text-center"><span t-esc="add_service.price" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/></td>
                                                        <td class="text-center"><span t-esc="add_service.total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/></td>
                                                        <td class="text-center"><span/></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>

                                    <!--############################-->
                            </t>
                        </tbody>
                        <br/><br/><br/><br/>
                        <tfoot name="document_totals" style="display: table-footer-group;">
                            <tr>
                                <td colspan="1"/>
                                <td>N. Doc.:<span t-esc="pickings_data['num_documents']"/></td>
                                <td colspan="4"/>
                                <td>
                                    <br/>
                                    <strong>Preparazione</strong><br/><br/>
                                    <strong>Diritto Fisso</strong><br/><br/>
                                    <strong>Servizi Logistici</strong><br/><br/>
                                </td>
                                <td class="text-center">
                                    <br/>
                                    <span t-esc="pickings_data['preparation_total']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/><br/><br/>
                                    <span t-esc="pickings_data['fixed_total']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/><br/><br/>
                                    <span t-esc="pickings_data['logistics_total']" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/><br/><br/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                </div>

            </div>
        </t>
    </template>

    <!-- Report action template -->
    <template id="report_logistics_services_invoicing_action">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="move">
                <t t-call="gll_stock_management.report_logistics_services_invoicing"/>
            </t>
        </t>
    </template>

    <!-- Register the report in the system -->
    <record id="action_report_logistics_services_invoicing" model="ir.actions.report">
        <field name="name">Fatturazione Servizi Logistici</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gll_stock_management.report_logistics_services_invoicing_action</field>
        <field name="report_file">gll_stock_management.report_logistics_services_invoicing_action</field>
        <field name="print_report_name">"Fatturazione_Servizi_Logistici_%(name)s"</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
