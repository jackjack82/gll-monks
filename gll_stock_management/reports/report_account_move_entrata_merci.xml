<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- QWeb template for the "Consuntivo entrata merci" report -->
    <template id="report_account_move_entrata_merci">
        <t t-call="web.external_layout">
            <div class="page">
                <!-- Customer information -->
                <div class="row">
                    <div class="col-12 text-start fw-bold">
                        <t t-esc="move.partner_id.display_name"/>
                    </div>
                </div>

                <!-- Title -->
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <h2>Consuntivo entrata merci</h2>
                    </div>
                </div>

                <!-- Content: For each picking found, display a table -->
                <t t-set="sale_orders" t-value="move.invoice_line_ids.mapped('sale_line_ids.order_id')"/>
                <t t-set="sale_order_lines" t-value="move.invoice_line_ids.mapped('sale_line_ids')"/>
                <t t-set="picking_services" t-value="env['picking.service'].search([('sale_line_id', 'in', sale_order_lines.ids)])"/>
                <t t-set="pickings" t-value="picking_services.mapped('picking_id').filtered(lambda p: p.picking_type_code == 'incoming' and p.all_service_ids)"/>

                <t t-if="pickings">
                    <t t-foreach="pickings" t-as="picking">
                        <div class="mt-4 mb-2">
                            <table name="pick_delivery_resume" class="table table-sm table-bordered" style="font-size: 8pt; border: 1px solid #000; border-collapse: collapse;">

                                <!-- Row 1: Picking metadata -->
                                <tr>
                                    <td class="text-start" style="width: 8.33%">
                                        <strong><t t-esc="picking.name"/></strong>
                                    </td>
                                    <td class="text-start" style="width: 8.33%">
                                        <t t-esc="picking.scheduled_date" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td class="text-start" style="width: 16.67%" colspan="2">
                                        <t t-esc="picking.partner_id.display_name"/>
                                    </td>
                                    <td class="text-start" style="width: 8.33%">
                                        <span>Volume: <t t-esc="picking.items_volume"/></span>
                                    </td>
                                    <td class="text-start" style="width: 58.33%" colspan="7">
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" disabled="disabled"/>
                                            <label class="form-check-label">Annullamento</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" disabled="disabled"/>
                                            <label class="form-check-label">Fermo deposito</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" disabled="disabled"/>
                                            <label class="form-check-label">Isole minori</label>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 2: Service headers -->
                                <tr>
                                    <th class="text-center" style="width: 16.67%" colspan="2">warehouse_total</th>
                                    <th class="text-center" style="width: 16.67%" colspan="2">transport_total</th>
                                    <th class="text-center" style="width: 16.67%" colspan="2">accessories_total</th>
                                    <th class="text-center" style="width: 16.67%" colspan="2">additional_total</th>
                                    <th class="text-center" style="width: 16.67%" colspan="2">fixed_total</th>
                                    <th class="text-center" style="width: 16.67%" colspan="2">variable_total</th>
                                </tr>

                                <!-- Row 3: Service values -->
                                <tr>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.warehouse_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.transport_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.accessories_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.additional_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.fixed_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                    <td class="text-center" style="width: 16.67%" colspan="2">
                                        <span t-esc="picking.variable_total" t-options="{'widget': 'monetary', 'display_currency': move.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="alert alert-info mt-4">
                        <p>No incoming transfers found for this invoice.</p>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Report action template -->
    <template id="report_account_move_entrata_merci_action">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="move">
                <t t-call="gll_stock_management.report_account_move_entrata_merci"/>
            </t>
        </t>
    </template>

    <!-- Register the report in the system -->
    <record id="action_report_account_move_entrata_merci" model="ir.actions.report">
        <field name="name">Consuntivo entrata merci</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gll_stock_management.report_account_move_entrata_merci_action</field>
        <field name="report_file">gll_stock_management.report_account_move_entrata_merci_action</field>
        <field name="print_report_name">"Consuntivo_entrata_merci_%(name)s"</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
