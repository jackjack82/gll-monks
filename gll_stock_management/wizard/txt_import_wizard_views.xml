<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_txt_import_wizard_form" model="ir.ui.view">
        <field name="name">gll.txt.import.wizard.form</field>
        <field name="model">gll.txt.import.wizard</field>
        <field name="arch" type="xml">
            <form string="TXT Import Wizard">
                <header>
                    <button name="action_import" string="Import" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error" options="{'clickable': 1}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_count">
                            <field name="picking_count" widget="statinfo" string="Deliveries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="file" filename="filename" readonly="state != 'draft'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Results">
                            <field name="results" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_txt_import_wizard_tree" model="ir.ui.view">
        <field name="name">gll.txt.import.wizard.tree</field>
        <field name="model">gll.txt.import.wizard</field>
        <field name="arch" type="xml">
            <list string="TXT Imports" decoration-success="state == 'done'" decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="state"/>
                <field name="picking_count"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_txt_import_wizard_search" model="ir.ui.view">
        <field name="name">gll.txt.import.wizard.search</field>
        <field name="model">gll.txt.import.wizard</field>
        <field name="arch" type="xml">
            <search string="TXT Imports">
                <field name="name"/>
                <field name="filename"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Import Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_txt_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Spedizioni</field>
        <field name="res_model">gll.txt.import.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new TXT import
            </p>
            <p>
                Import stock pickings from TXT files.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_txt_import_wizard"
              name="Import Spedizioni"
              parent="stock.menu_stock_root"
              action="action_txt_import_wizard"
              sequence="100"/>
</odoo>
