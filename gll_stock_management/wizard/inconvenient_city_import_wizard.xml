<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_excel_import_inconvenient_wizard_form" model="ir.ui.view">
        <field name="name">gll.excel.import.inconvenient.wizard.form</field>
        <field name="model">gll.excel.import.inconvenient.wizard</field>
        <field name="arch" type="xml">
            <form string="Excel Import Wizard for Inconvenient Places">
                <header>
                    <button name="action_import" string="Import" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error" options="{'clickable': 1}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div>
                        Wizzard per l'importazione delle Città Disagiate. Selezionare il Corriere e la Nazione.<br/>
                        I campi obbligatori per il file di excel di import sono (tra <br/>
                        parentesi il nome della colonna del file excel):
                        1) Nome località (name)
                        2) Codice provincia, ad esepio RM, MI, TO (state)
                        3) CAP (zip)

                    </div>
                    <group>
                        <group>
                            <field name="file" filename="filename" readonly="state != 'draft'"/>
                            <field name="filename" invisible="1"/>
                            <field name="carrier_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="country_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Results">
                            <field name="results" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_excel_import_inconvenient_wizard_tree" model="ir.ui.view">
        <field name="name">gll.excel.import.inconvenient.wizard.tree</field>
        <field name="model">gll.excel.import.inconvenient.wizard</field>
        <field name="arch" type="xml">
            <list string="Excel Imports" decoration-success="state == 'done'" decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_excel_import_inconvenient_wizard_search" model="ir.ui.view">
        <field name="name">gll.excel.import.inconvenient.wizard.search</field>
        <field name="model">gll.excel.import.inconvenient.wizard</field>
        <field name="arch" type="xml">
            <search string="Excel Imports">
                <field name="name"/>
                <field name="filename"/>
                <field name="carrier_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Carrier" name="group_by_carrier" context="{'group_by': 'carrier_id'}"/>
                    <filter string="Import Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_excel_import_inconvenient_wizard" model="ir.actions.act_window">
        <field name="name">Import Inconvenient Places</field>
        <field name="res_model">gll.excel.import.inconvenient.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Excel import for inconvenient places
            </p>
            <p>
                Import inconvenient places from Excel files and associate them with delivery carriers.

            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_excel_import_inconvenient_wizard"
              name="Import Inconvenient Places"
              parent="stock.menu_stock_root"
              action="action_excel_import_inconvenient_wizard"
              sequence="101"/>
</odoo>