<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_category_form_view" model="ir.ui.view">
            <field name="name">ev_stock.product.category.form</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="is_vas_category"/>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="intrastat_code_id" class="oe_inline"/>
                </xpath>

            </field>
        </record>

        <record model="ir.ui.view" id="product_template_hs_code">
        <field name="name">product.template.form.hs_code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='hs_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='hs_code']" position="after">
                <field name="intrastat_code_id"/>
            </xpath>
        </field>
    </record>
    </data>
</odoo>
