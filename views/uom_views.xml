<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend UoM Form View -->
    <record id="uom_uom_form_view_inherit" model="ir.ui.view">
        <field name="name">uom.uom.form.inherit</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <field name="rounding" position="after">
                <field name="import_code"/>
            </field>
        </field>
    </record>

    <!-- Extend UoM Tree View -->
    <record id="uom_uom_tree_view_inherit" model="ir.ui.view">
        <field name="name">uom.uom.tree.inherit</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="import_code"/>
            </field>
        </field>
    </record>


    <!-- Extend UoM Tree View -->
    <record id="gll_product_uom_categ_form_view" model="ir.ui.view">
        <field name="name">uom.category.form</field>
        <field name="model">uom.category</field>
        <field name="inherit_id" ref="uom.product_uom_categ_form_view"/>
        <field name="arch" type="xml">
            <field name="uom_type" position="before">
                <field name="import_code"/>
            </field>
        </field>
    </record>

</odoo>
