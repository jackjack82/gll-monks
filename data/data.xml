<data>
            <!-- Server action create a SO from transfer packages -->
        <record id="action_create_so_from_receipts" model="ir.actions.server">
            <field name="name">Crea Ordini di Vendita (Ricezioni)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
action = records.create_sale_order_packages('receipts')
            </field>
        </record>

        <record id="action_create_so_from_deliveries" model="ir.actions.server">
            <field name="name">Crea Ordini di Vendita (Spedizioni)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
action = records.create_sale_order_packages('deliveries')
            </field>
        </record>

    <record id="gll_receipts_report" model="ir.actions.report">
        <field name="name">Entrata Merci</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gll_stock_management.report_entrata_merci</field>
        <field name="report_file">gll_stock_management.report_entrata_merci_pdf</field>
        <field name="print_report_name">'Entrata Merci'</field>
    </record>

</data>
